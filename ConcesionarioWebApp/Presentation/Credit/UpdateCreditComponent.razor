@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Crédito (ID: @Id)</h3>

@if (objCredit == null)
{
    <p>Cargando datos del crédito...</p>
}
else
{
    <EditForm Model="objCredit" OnValidSubmit="UpdateCredit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Pago Asociado:</label>
            <InputSelect @bind-Value="objCredit.id_pago" class="form-control">
                <option value="0">-- Seleccione un Pago --</option>
                @if (pays != null)
                {
                    @foreach (var pay in pays)
                    {
                        <option value="@pay.id_pago">
                            Pago #@pay.id_pago - Venta #@pay.id_venta (@pay.monto.ToString("C"))
                        </option>
                    }
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Entidad Bancaria:</label>
            <InputText @bind-Value="objCredit.entidad_bancaria" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Monto Aprobado:</label>
            <InputNumber @bind-Value="objCredit.monto_aprobado" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Número de Cuotas:</label>
            <InputNumber @bind-Value="objCredit.numero_cuotas" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CreditEntity? objCredit;
    private List<PayEntity>? pays;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        pays = await Task.Run(() => PayLog.PayList());
        objCredit = await Task.Run(() => CreditLog.CreditList().FirstOrDefault(c => c.id_credito == Id));

        if (objCredit == null)
        {
            message = "No se encontró el crédito especificado.";
        }
    }

    private void UpdateCredit()
    {
        try
        {
            if (objCredit != null)
            {
                CreditLog.UpdateCredit(objCredit);
                message = "¡Crédito actualizado con éxito!";
                NavManager.NavigateTo("/credit/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/credit/list");
    }
}