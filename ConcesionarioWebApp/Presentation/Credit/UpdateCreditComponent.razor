@using Logic
@using Model
@inject NavigationManager NavManager
@inject CreditLog CreditLog
@inject PayLog PayLog

<h3>Actualizar Crédito (ID: @Id)</h3>

@if (objCredit == null)
{
    @if (message == null)
    {
        <p>Cargando datos del crédito...</p>
    }
}
else
{
    <EditForm Model="objCredit" OnValidSubmit="UpdateCredit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Pago Asociado:</label>
            <InputSelect @bind-Value="objCredit.IdPago" class="form-control">
                <option value="0">-- Seleccione un Pago --</option>
                @if (pays != null)
                {
                    @foreach (var pay in pays)
                    {
                        <option value="@pay.IdPago">
                            Pago #@pay.IdPago - Venta #@pay.IdVenta (@pay.Monto.ToString("C"))
                        </option>
                    }
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Entidad Bancaria:</label>
            <InputText @bind-Value="objCredit.EntidadBancaria" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Monto Aprobado:</label>
            <InputNumber @bind-Value="objCredit.MontoAprobado" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Número de Cuotas:</label>
            <InputNumber @bind-Value="objCredit.NumeroCuotas" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private CreditEntity? objCredit;
    private List<PayEntity>? pays;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pays = await PayLog.PayListAsync();
            objCredit = await CreditLog.GetCreditByIdAsync(Id);

            if (objCredit == null)
            {
                message = "No se encontró el crédito especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el crédito: {ex.Message}";
        }
    }

    private async Task UpdateCredit()
    {
        try
        {
            if (objCredit != null)
            {
                await CreditLog.UpdateCreditAsync(objCredit);
                message = "¡Crédito actualizado con éxito!";
                NavManager.NavigateTo("/credit/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/credit/list");
    }
}