@using Logic
@using Model
@inject NavigationManager NavManager
@inject CreditLog CreditLog
@inject PayLog PayLog

<h3>Registrar Crédito Bancario</h3>

<EditForm Model="objCredit" OnValidSubmit="SaveCredit" FormName="FrmCredit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Pago Asociado:</label>
        <InputSelect @bind-Value="objCredit.IdPago" class="form-control">
            <option value="0">-- Seleccione un Pago --</option>
            @if (pays != null)
            {
                @foreach (var pay in pays)
                {
                    <option value="@pay.IdPago">
                        Pago #@pay.IdPago - Venta #@pay.IdVenta (@pay.Monto.ToString("C"))
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Entidad Bancaria:</label>
        <InputText @bind-Value="objCredit.EntidadBancaria" class="form-control" placeholder="Ej. Bancolombia, BBVA, Davivienda" />
    </div>

    <div class="mb-3">
        <label class="form-label">Monto Aprobado:</label>
        <InputNumber @bind-Value="objCredit.MontoAprobado" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Número de Cuotas:</label>
        <InputNumber @bind-Value="objCredit.NumeroCuotas" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Crédito</button>
    <a href="/credit/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    CreditEntity objCredit = new CreditEntity();
    private string? successMessage;
    List<PayEntity> pays = new List<PayEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Se cargan los pagos registrados para vincular el crédito al ID de pago correspondiente
            pays = await PayLog.PayListAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar los pagos: {ex.Message}";
        }
    }

    private async Task SaveCredit()
    {
        try
        {
            await CreditLog.CreateCreditAsync(objCredit);
            successMessage = $"¡El crédito con {objCredit.EntidadBancaria} por ${objCredit.MontoAprobado} se registró exitosamente!";
            objCredit = new CreditEntity();
            NavManager.NavigateTo("/credit/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el crédito: {ex.Message}";
        }
    }
}