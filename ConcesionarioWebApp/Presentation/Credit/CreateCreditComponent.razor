@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Registrar Crédito Bancario</h3>

<EditForm Model="objCredit" OnValidSubmit="SaveCredit" FormName="FrmCredit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Pago Asociado:</label>
        <InputSelect @bind-Value="objCredit.id_pago" class="form-control">
            <option value="0">-- Seleccione un Pago --</option>
            @if (pays != null)
            {
                @foreach (var pay in pays)
                {
                    <option value="@pay.id_pago">
                        Pago #@pay.id_pago - Venta #@pay.id_venta (@pay.monto.ToString("C"))
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Entidad Bancaria:</label>
        <InputText @bind-Value="objCredit.entidad_bancaria" class="form-control" placeholder="Ej. Bancolombia, BBVA, Davivienda" />
    </div>

    <div class="mb-3">
        <label class="form-label">Monto Aprobado:</label>
        <InputNumber @bind-Value="objCredit.monto_aprobado" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Número de Cuotas:</label>
        <InputNumber @bind-Value="objCredit.numero_cuotas" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Crédito</button>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    CreditEntity objCredit = new CreditEntity();
    private string? successMessage;
    List<PayEntity> pays = new List<PayEntity>();

    protected override async Task OnInitializedAsync()
    {
        // Se cargan los pagos registrados para vincular el crédito al ID de pago correspondiente
        pays = await Task.Run(() => PayLog.PayList());
    }

    private void SaveCredit()
    {
        try
        {
            CreditLog.CreateCredit(objCredit);
            successMessage = $"¡El crédito con {objCredit.entidad_bancaria} por ${objCredit.monto_aprobado} se registró exitosamente!";
            objCredit = new CreditEntity();
            NavManager.NavigateTo("/credit/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el crédito: {ex.Message}";
        }
    }
}