@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Listado de Garantías</h3>

<div class="mb-3">
    <a href="/warranty/create" class="btn btn-primary">Nueva Garantía</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Garantía</th>
        <th>ID Detalle Venta</th>
        <th>Fecha de Inicio</th>
        <th>Condiciones</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (warranties == null)
    {
        <tr>
            <td colspan="5">Cargando garantías...</td>
        </tr>
    }
    else if (!warranties.Any())
    {
        <tr>
            <td colspan="5">No hay garantías registradas.</td>
        </tr>
    }
    else
    {
        @foreach (var warranty in warranties)
        {
            <tr>
                <td>@warranty.id_garantia</td>
                <td>@warranty.id_detalle</td>
                <td>@warranty.fecha_inicio.ToString("dd/MM/yyyy")</td>
                <td>@warranty.condiciones</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(warranty.id_garantia)">
                        Editar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private List<WarrantyEntity>? warranties;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warranties = await Task.Run(() => WarrantyLog.WarrantyList());
        }
        catch (Exception ex)
        {
            message = $"Error al cargar las garantías: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/warranty/update/{id}");
    }
}
