@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject WarrantyLog WarrantyLog

<h3>Listado de Garantías</h3>

<div class="mb-3">
    <a href="/warranty/create" class="btn btn-primary">Nueva Garantía</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Garantía</th>
        <th>ID Detalle Venta</th>
        <th>Fecha de Inicio</th>
        <th>Condiciones</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (warranties == null)
    {
        <tr>
            <td colspan="5">Cargando garantías...</td>
        </tr>
    }
    else if (!warranties.Any())
    {
        <tr>
            <td colspan="5">No hay garantías registradas.</td>
        </tr>
    }
    else
    {
        @foreach (var warranty in warranties)
        {
            <tr>
                <td>@warranty.IdGarantia</td>
                <td>@warranty.IdDetalle</td>
                <td>@warranty.FechaInicio.ToString("dd/MM/yyyy")</td>
                <td>@warranty.Condiciones</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(warranty.IdGarantia)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(warranty.IdGarantia)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private List<WarrantyEntity>? warranties;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadWarranties();
    }

    private async Task LoadWarranties()
    {
        try
        {
            warranties = await WarrantyLog.WarrantyListAsync();
        }
        catch (Exception ex)
        {
            warranties ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar la garantía #{id}?"))
        {
            return;
        }

        try
        {
            await WarrantyLog.DeleteWarrantyAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadWarranties();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar la garantía: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/warranty/update/{id}");
    }
}
