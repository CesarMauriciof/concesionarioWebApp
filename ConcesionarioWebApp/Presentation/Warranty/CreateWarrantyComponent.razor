@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Registrar Garantía</h3>

<EditForm Model="objWarranty" OnValidSubmit="SaveWarranty" FormName="FrmWarranty">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Detalle de Venta:</label>
        <InputSelect @bind-Value="objWarranty.id_detalle" class="form-control">
            <option value="0">-- Seleccione un Detalle de Venta --</option>
            @if (saleDetails != null)
            {
                @foreach (var detail in saleDetails)
                {
                    <option value="@detail.id_detalle">
                        Detalle #@detail.id_detalle - Venta #@detail.id_venta - Vehículo #@detail.id_vehiculo
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Inicio:</label>
        <InputDate @bind-Value="objWarranty.fecha_inicio" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Condiciones:</label>
        <InputTextArea @bind-Value="objWarranty.condiciones" class="form-control" placeholder="Ej. Cubre motor y transmisión por 3 años" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Garantía</button>
    <a href="/warranty/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    WarrantyEntity objWarranty = new WarrantyEntity { fecha_inicio = DateTime.Today };
    private string? successMessage;
    List<SaleDetailEntity> saleDetails = new List<SaleDetailEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Se cargan los detalles de venta para asociar la garantía al vehículo vendido
            saleDetails = await Task.Run(() => SaleDetailLog.SaleDetailList());
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar los detalles de venta: {ex.Message}";
        }
    }

    private void SaveWarranty()
    {
        try
        {
            WarrantyLog.CreateWarranty(objWarranty);
            successMessage = $"¡La garantía para el detalle #{objWarranty.id_detalle} se registró exitosamente!";
            objWarranty = new WarrantyEntity { fecha_inicio = DateTime.Today };
            NavManager.NavigateTo("/warranty/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar la garantía: {ex.Message}";
        }
    }
}
