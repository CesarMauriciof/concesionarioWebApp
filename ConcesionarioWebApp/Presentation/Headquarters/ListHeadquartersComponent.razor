@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject HeadquartersLog HeadquartersLog

<h3>Gestión de Sedes</h3>

<div class="mb-3">
    <a href="/headquarters/create" class="btn btn-primary">Nueva Sede</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Sede</th>
        <th>Nombre de Sede</th>
        <th>Ciudad</th>
        <th>Dirección</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (headquartersList == null)
    {
        <tr>
            <td colspan="5">Cargando sedes...</td>
        </tr>
    }
    else if (!headquartersList.Any())
    {
        <tr>
            <td colspan="5">No hay sedes registradas.</td>
        </tr>
    }
    else
    {
        @foreach (var hq in headquartersList)
        {
            <tr>
                <td>@hq.IdSede</td>
                <td>@hq.NombreSede</td>
                <td>@hq.Ciudad</td>
                <td>@hq.Direccion</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(hq.IdSede)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(hq.IdSede)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private string? message;
    private List<HeadquartersEntity>? headquartersList;

    protected override async Task OnInitializedAsync()
    {
        await LoadHeadquartersList();
    }

    private async Task LoadHeadquartersList()
    {
        try
        {
            headquartersList = await HeadquartersLog.HeadquartersListAsync();
        }
        catch (Exception ex)
        {
            headquartersList ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar la sede #{id}?"))
        {
            return;
        }

        try
        {
            await HeadquartersLog.DeleteHeadquartersAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadHeadquartersList();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar la sede: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/headquarters/update/{id}");
    }
}