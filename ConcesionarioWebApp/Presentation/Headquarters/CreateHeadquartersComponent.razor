@using Logic
@using Model
@inject NavigationManager NavManager
@inject HeadquartersLog HeadquartersLog

<h3>Registrar Nueva Sede</h3>

<EditForm Model="objHeadquarters" OnValidSubmit="SaveHeadquarters" FormName="FrmHeadquarters">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre de la Sede:</label>
        <InputText @bind-Value="objHeadquarters.NombreSede" class="form-control" placeholder="Ej. Sede Sur" />
    </div>

    <div class="mb-3">
        <label class="form-label">Ciudad:</label>
        <InputText @bind-Value="objHeadquarters.Ciudad" class="form-control" placeholder="Ej. Popayán" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección:</label>
        <InputText @bind-Value="objHeadquarters.Direccion" class="form-control" placeholder="Ej. Calle 5 # 10-20" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Sede</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
</EditForm>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private HeadquartersEntity objHeadquarters = new HeadquartersEntity();
    private string? message;

    private async Task SaveHeadquarters()
    {
        try
        {
            await HeadquartersLog.CreateHeadquartersAsync(objHeadquarters);
            message = "¡Sede guardada con éxito!";
            objHeadquarters = new HeadquartersEntity();
            NavManager.NavigateTo("/headquarters/list");
        }
        catch (Exception ex)
        {
            message = $"Error al guardar la sede: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/headquarters/list");
    }
}
