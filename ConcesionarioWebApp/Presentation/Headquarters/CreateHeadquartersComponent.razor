@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Sede ID: @Id</h3>

@if (objHeadquarters == null)
{
    <p>Cargando datos de la sede...</p>
}
else
{
    <EditForm Model="objHeadquarters" OnValidSubmit="UpdateHeadquarters">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre de la Sede:</label>
            <InputText @bind-Value="objHeadquarters.NombreSede" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Ciudad:</label>
            <InputText @bind-Value="objHeadquarters.Ciudad" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Dirección:</label>
            <InputText @bind-Value="objHeadquarters.Direccion" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private HeadquartersEntity? objHeadquarters;
    private string? message;
    private List<HeadquartersEntity> headquartersList = new();

    protected override async Task OnInitializedAsync()
    {
        headquartersList = HeadquartersLog.HeadquartersList();
        objHeadquarters = headquartersList.FirstOrDefault(h => h.IdSede == Id);

        if (objHeadquarters == null)
        {
            message = "No se encontró la sede especificada.";
        }
    }

    private void UpdateHeadquarters()
    {
        try
        {
            if (objHeadquarters != null)
            {
                // Asegúrate de tener UpdateHeadquarters en tu Logic
                HeadquartersLog.UpdateHeadquarters(objHeadquarters);
                message = "¡Sede actualizada con éxito!";
                NavManager.NavigateTo("/headquarters/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/headquarters/list");
    }
}