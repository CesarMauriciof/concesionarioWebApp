@using ConcesionarioWebApp.Model
@using Logic
@inject NavigationManager Navigation

<h3>Registrar Nuevo Vehículo</h3>

<EditForm Model="vehicle" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">VIN:</label>
        <InputText class="form-control" @bind-Value="vehicle.Vin" />
    </div>

    <div class="mb-3">
        <label class="form-label">Marca:</label>
        <InputText class="form-control" @bind-Value="vehicle.Marca" />
    </div>

    <div class="mb-3">
        <label class="form-label">Modelo:</label>
        <InputText class="form-control" @bind-Value="vehicle.Modelo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Precio:</label>
        <InputNumber class="form-control" @bind-Value="vehicle.Precio" />
    </div>

    <div class="mb-3">
        <label class="form-label">ID Sede:</label>
        <InputNumber class="form-control" @bind-Value="vehicle.IdSede" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a href="/ListVehiclePage" class="btn btn-secondary">Cancelar</a>
</EditForm>

@code {
    private VehicleEntity vehicle = new();

    private void HandleValidSubmit()
    {
        VehicleLog.CreateVehicle(vehicle);
        Navigation.NavigateTo("/vehiculos");
    }
}