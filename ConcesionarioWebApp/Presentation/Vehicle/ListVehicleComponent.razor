@using Logic
@using Model
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject VehicleLog VehicleLog

<h3>Gestión de Vehículos</h3>

<div class="mb-3">
    <a href="/vehicle/create" class="btn btn-primary">Nuevo Vehículo</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>VIN</th>
        <th>Marca</th>
        <th>Modelo</th>
        <th>Precio</th>
        <th>Sede</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (vehicles == null)
    {
        <tr>
            <td colspan="7">Cargando vehículos...</td>
        </tr>
    }
    else if (!vehicles.Any())
    {
        <tr>
            <td colspan="7">No hay vehículos registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var v in vehicles)
        {
            <tr>
                <td>@v.IdVehiculo</td>
                <td>@v.Vin</td>
                <td>@v.Marca</td>
                <td>@v.Modelo</td>
                <td>@v.Precio.ToString("C")</td>
                <td>@(v.Sede?.NombreSede ?? "Sin sede")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(v.IdVehiculo)">Editar</button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(v.IdVehiculo)">Eliminar</button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private List<VehicleEntity>? vehicles;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        try
        {
            vehicles = await VehicleLog.VehicleListAsync();
        }
        catch (Exception ex)
        {
            vehicles ??= new();
            message = $"Error al cargar los vehículos: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        Navigation.NavigateTo($"/vehicle/update/{id}");
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el vehículo #{id}?"))
        {
            return;
        }

        try
        {
            await VehicleLog.DeleteVehicleAsync(id);
            message = "Vehículo eliminado correctamente.";
            await LoadVehicles();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar el vehículo: {ex.Message}";
        }
    }
}
