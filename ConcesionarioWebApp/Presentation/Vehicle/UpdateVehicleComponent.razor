@using ConcesionarioWebApp.Model
@using Logic
@inject NavigationManager Navigation

<h3>Actualizar Vehículo</h3>

@if (vehicle == null)
{
    <p><em>Cargando vehículo...</em></p>
}
else
{
    <EditForm Model="vehicle" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">VIN:</label>
            <InputText class="form-control" @bind-Value="vehicle.Vin" />
        </div>

        <div class="mb-3">
            <label class="form-label">Marca:</label>
            <InputText class="form-control" @bind-Value="vehicle.Marca" />
        </div>

        <div class="mb-3">
            <label class="form-label">Modelo:</label>
            <InputText class="form-control" @bind-Value="vehicle.Modelo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Precio:</label>
            <InputNumber class="form-control" @bind-Value="vehicle.Precio" />
        </div>

        <div class="mb-3">
            <label class="form-label">ID Sede:</label>
            <InputNumber class="form-control" @bind-Value="vehicle.IdSede" />
        </div>

        <button type="submit" class="btn btn-primary">Actualizar</button>
        <a href="/vehiculos" class="btn btn-secondary">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private VehicleEntity? vehicle;

    protected override void OnParametersSet()
    {
        vehicle = VehicleLog.GetVehicleById(Id);
    }

    private void HandleValidSubmit()
    {
        if (vehicle != null)
        {
            VehicleLog.UpdateVehicle(vehicle);
            Navigation.NavigateTo("/vehiculos");
        }
    }
}