@using Model
@using Logic
@inject NavigationManager Navigation
@inject HeadquartersLog HeadquartersLog
@inject VehicleLog VehicleLog

<h3>Actualizar Vehículo</h3>

@if (vehicle == null)
{
    @if (message == null)
    {
        <p><em>Cargando vehículo...</em></p>
    }
}
else
{
    <EditForm Model="vehicle" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">VIN:</label>
            <InputText class="form-control" @bind-Value="vehicle.Vin" />
        </div>

        <div class="mb-3">
            <label class="form-label">Marca:</label>
            <InputText class="form-control" @bind-Value="vehicle.Marca" />
        </div>

        <div class="mb-3">
            <label class="form-label">Modelo:</label>
            <InputText class="form-control" @bind-Value="vehicle.Modelo" />
        </div>

        <div class="mb-3">
            <label class="form-label">Precio:</label>
            <InputNumber class="form-control" @bind-Value="vehicle.Precio" />
        </div>

        <div class="mb-3">
            <label class="form-label">Sede:</label>
            <InputSelect TValue="int?" class="form-control" @bind-Value="vehicle.IdSede">
                <option value="0">-- Seleccione una sede --</option>
                @if (headquartersList != null)
                {
                    @foreach (var sede in headquartersList)
                    {
                        <option value="@sede.IdSede">@sede.NombreSede</option>
                    }
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-primary">Actualizar</button>
        <a href="/vehicle/list" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private VehicleEntity? vehicle;
    private List<HeadquartersEntity>? headquartersList;
    private string? message;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            headquartersList = await HeadquartersLog.HeadquartersListAsync();
            vehicle = await VehicleLog.GetVehicleByIdAsync(Id);

            if (vehicle == null)
            {
                message = "No se encontró el vehículo especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el vehículo: {ex.Message}";
        }
    }

    private async Task HandleValidSubmit()
    {
        try
        {
            if (vehicle != null)
            {
                await VehicleLog.UpdateVehicleAsync(vehicle);
                Navigation.NavigateTo("/vehicle/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar el vehículo: {ex.Message}";
        }
    }
}
