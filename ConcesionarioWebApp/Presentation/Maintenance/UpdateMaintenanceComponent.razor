@using Logic
@using Model
@inject NavigationManager NavManager
@inject MaintenanceLog MaintenanceLog
@inject WarrantyLog WarrantyLog

<h3>Actualizar Mantenimiento (ID: @Id)</h3>

@if (objMaintenance == null)
{
    <p>Cargando datos del mantenimiento...</p>
}
else
{
    <EditForm Model="objMaintenance" OnValidSubmit="UpdateMaintenance">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Garantía Asociada:</label>
            <InputSelect @bind-Value="objMaintenance.IdGarantia" class="form-control">
                <option value="0">-- Seleccione una Garantía --</option>
                @if (warranties != null)
                {
                    @foreach (var warranty in warranties)
                    {
                        <option value="@warranty.IdGarantia">
                            Garantía #@warranty.IdGarantia - Detalle #@warranty.IdDetalle (desde @warranty.FechaInicio.ToString("dd/MM/yyyy"))
                        </option>
                    }
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Kilometraje:</label>
            <InputNumber @bind-Value="objMaintenance.Kilometraje" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Año del Mantenimiento:</label>
            <InputNumber @bind-Value="objMaintenance.AnioMantenimiento" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Servicios Realizados:</label>
            <InputTextArea @bind-Value="objMaintenance.ServiciosRealizados" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha Programada:</label>
            <InputDate @bind-Value="objMaintenance.FechaProgramada" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private MaintenanceEntity? objMaintenance;
    private List<WarrantyEntity>? warranties;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warranties = await WarrantyLog.WarrantyListAsync();
            objMaintenance = await MaintenanceLog.GetMaintenanceByIdAsync(Id);

            if (objMaintenance == null)
            {
                message = "No se encontró el mantenimiento especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el mantenimiento: {ex.Message}";
        }
    }

    private async Task UpdateMaintenance()
    {
        try
        {
            if (objMaintenance != null)
            {
                await MaintenanceLog.UpdateMaintenanceAsync(objMaintenance);
                message = "¡Mantenimiento actualizado con éxito!";
                NavManager.NavigateTo("/maintenance/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/maintenance/list");
    }
}