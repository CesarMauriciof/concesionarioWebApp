@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject MaintenanceLog MaintenanceLog

<h3>Listado de Mantenimientos</h3>

<div class="mb-3">
    <a href="/maintenance/create" class="btn btn-primary">Nuevo Mantenimiento</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Mantenimiento</th>
        <th>ID Garantía</th>
        <th>Kilometraje</th>
        <th>Año</th>
        <th>Servicios Realizados</th>
        <th>Fecha Programada</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (maintenances == null)
    {
        <tr>
            <td colspan="7">Cargando mantenimientos...</td>
        </tr>
    }
    else if (!maintenances.Any())
    {
        <tr>
            <td colspan="7">No hay mantenimientos registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var maintenance in maintenances)
        {
            <tr>
                <td>@maintenance.IdMantenimiento</td>
                <td>@maintenance.IdGarantia</td>
                <td>@maintenance.Kilometraje.ToString("N0") km</td>
                <td>@maintenance.AnioMantenimiento</td>
                <td>@maintenance.ServiciosRealizados</td>
                <td>@maintenance.FechaProgramada.ToString("dd/MM/yyyy")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(maintenance.IdMantenimiento)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(maintenance.IdMantenimiento)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private List<MaintenanceEntity>? maintenances;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        await LoadMaintenances();
    }

    private async Task LoadMaintenances()
    {
        try
        {
            maintenances = await MaintenanceLog.MaintenanceListAsync();
        }
        catch (Exception ex)
        {
            maintenances ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el mantenimiento #{id}?"))
        {
            return;
        }

        try
        {
            await MaintenanceLog.DeleteMaintenanceAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadMaintenances();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar el mantenimiento: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/maintenance/update/{id}");
    }
}
