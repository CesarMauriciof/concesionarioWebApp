@using Logic
@using Model
@inject NavigationManager NavManager
@inject MaintenanceLog MaintenanceLog
@inject WarrantyLog WarrantyLog

<h3>Programar Mantenimiento</h3>

<EditForm Model="objMaintenance" OnValidSubmit="SaveMaintenance">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Garantía Asociada:</label>
        <InputSelect @bind-Value="objMaintenance.IdGarantia" class="form-control">
            <option value="0">-- Seleccione una Garantía --</option>
            @if (warranties != null)
            {
                @foreach (var warranty in warranties)
                {
                    <option value="@warranty.IdGarantia">
                        Garantía #@warranty.IdGarantia - Detalle #@warranty.IdDetalle (desde @warranty.FechaInicio.ToString("dd/MM/yyyy"))
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Kilometraje:</label>
        <InputNumber @bind-Value="objMaintenance.Kilometraje" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Año del Mantenimiento:</label>
        <InputNumber @bind-Value="objMaintenance.AnioMantenimiento" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Servicios Realizados:</label>
        <InputTextArea @bind-Value="objMaintenance.ServiciosRealizados" class="form-control" placeholder="Ej. Cambio de aceite, revisión de frenos" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha Programada:</label>
        <InputDate @bind-Value="objMaintenance.FechaProgramada" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Mantenimiento</button>
    <a href="/maintenance/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    private MaintenanceEntity objMaintenance = NewMaintenance();

    private string? successMessage;
    List<WarrantyEntity> warranties = new List<WarrantyEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warranties = await WarrantyLog.WarrantyListAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar las garantías: {ex.Message}";
        }
    }

    private static MaintenanceEntity NewMaintenance()
    {
        return new MaintenanceEntity
        {
            AnioMantenimiento = DateTime.Today.Year,
            FechaProgramada = DateTime.Today
        };
    }

    private async Task SaveMaintenance()
    {
        try
        {
            await MaintenanceLog.CreateMaintenanceAsync(objMaintenance);
            successMessage = $"¡El mantenimiento para la garantía #{objMaintenance.IdGarantia} se registró exitosamente!";
            objMaintenance = NewMaintenance();
            NavManager.NavigateTo("/maintenance/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el mantenimiento: {ex.Message}";
        }
    }
}