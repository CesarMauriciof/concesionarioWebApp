@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Programar Mantenimiento</h3>

<EditForm Model="objMaintenance" OnValidSubmit="SaveMaintenance">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Garantía Asociada:</label>
        <InputSelect @bind-Value="objMaintenance.id_garantia" class="form-control">
            <option value="0">-- Seleccione una Garantía --</option>
            @if (warranties != null)
            {
                @foreach (var warranty in warranties)
                {
                    <option value="@warranty.id_garantia">
                        Garantía #@warranty.id_garantia - Detalle #@warranty.id_detalle (desde @warranty.fecha_inicio.ToString("dd/MM/yyyy"))
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Kilometraje:</label>
        <InputNumber @bind-Value="objMaintenance.kilometraje" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Año del Mantenimiento:</label>
        <InputNumber @bind-Value="objMaintenance.año_mantenimiento" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Servicios Realizados:</label>
        <InputTextArea @bind-Value="objMaintenance.servicios_realizados" class="form-control" placeholder="Ej. Cambio de aceite, revisión de frenos" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha Programada:</label>
        <InputDate @bind-Value="objMaintenance.fecha_programada" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Mantenimiento</button>
    <a href="/maintenance/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    private MaintenanceEntity objMaintenance = NewMaintenance();

    private string? successMessage;
    List<WarrantyEntity> warranties = new List<WarrantyEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            warranties = await Task.Run(() => WarrantyLog.WarrantyList());
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar las garantías: {ex.Message}";
        }
    }

    private static MaintenanceEntity NewMaintenance()
    {
        return new MaintenanceEntity
        {
            año_mantenimiento = DateTime.Today.Year,
            fecha_programada = DateTime.Today
        };
    }

    private void SaveMaintenance()
    {
        try
        {
            MaintenanceLog.CreateMaintenance(objMaintenance);
            successMessage = $"¡El mantenimiento para la garantía #{objMaintenance.id_garantia} se registró exitosamente!";
            objMaintenance = NewMaintenance();
            NavManager.NavigateTo("/maintenance/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el mantenimiento: {ex.Message}";
        }
    }
}