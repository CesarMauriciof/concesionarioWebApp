@page "/acceso-denegado"
@layout LoginLayout
@attribute [AllowAnonymous]

@*
    Se muestra cuando un usuario con sesión iniciada entra a una página que su rol no permite
    (p. ej. un Vendedor entrando a /user/list).
*@

<PageTitle>Acceso denegado</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4 text-center">
        <h1 class="h4 text-danger">Acceso denegado</h1>
        <p class="mb-4">No tiene permisos para ver esta página. Si cree que es un error, comuníquese con el administrador.</p>

        <a href="" class="btn btn-primary w-100 mb-2">Volver al inicio</a>

        @* Cerrar la sesión actual para entrar con otra cuenta (POST con antiforgery) *@
        <form method="post" action="auth/logout">
            <AntiforgeryToken />
            <button type="submit" class="btn btn-outline-secondary w-100">Iniciar sesión con otra cuenta</button>
        </form>
    </div>
</div>