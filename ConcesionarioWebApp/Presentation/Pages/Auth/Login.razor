@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Google
@inject IAuthenticationSchemeProvider SchemeProvider
@inject NavigationManager Navigation

@*
    Formulario de inicio de sesión.

    Este componente NO inicia sesión con código C# (la app es InteractiveServer y desde ahí no se
    pueden escribir cookies). Solo envía al usuario a los endpoints HTTP de Presentation/Auth:
      - Google:  GET  /auth/login/google?returnUrl=...
      - Local:   POST /auth/login-local  (campos usuario, contrasena, returnUrl + token antiforgery)
*@

<PageTitle>Iniciar sesión</PageTitle>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <h1 class="h4 text-center mb-1">Concesionario WebApp</h1>
        <p class="text-center text-body-secondary mb-4">Inicie sesión para continuar</p>

        @if (Logout == "1")
        {
            <div class="alert alert-success py-2" role="status">Sesión cerrada correctamente.</div>
        }

        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="alert alert-danger py-2" role="alert">@Error</div>
        }

        @if (googleEnabled)
        {
            <a href="@GoogleUrl" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                Iniciar sesión con Google
            </a>

            <div class="d-flex align-items-center my-3 text-body-secondary">
                <hr class="flex-grow-1" /><span class="px-2 small">o</span><hr class="flex-grow-1" />
            </div>
        }
        else
        {
            <div class="alert alert-warning py-2 small">
                El inicio de sesión con Google no está configurado en este equipo.
            </div>
        }

        @* Formulario HTML normal (no EditForm): el navegador hace un POST real al endpoint *@
        <form method="post" action="auth/login-local">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />

            <div class="mb-3">
                <label for="usuario" class="form-label">Usuario</label>
                <input id="usuario" name="usuario" class="form-control" autocomplete="username" required />
            </div>

            <div class="mb-3">
                <label for="contrasena" class="form-label">Contraseña</label>
                <input id="contrasena" name="contrasena" type="password" class="form-control"
                       autocomplete="current-password" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div>
</div>

<p class="text-center text-body-secondary small mt-3">
    ¿No tiene acceso? Solicítelo al administrador del sistema.
</p>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>Mensaje de error que envían los endpoints: /login?error=...</summary>
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    /// <summary>Página a la que se vuelve después de iniciar sesión: /login?returnUrl=/sale/list</summary>
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    /// <summary>"1" cuando se viene de cerrar sesión: /login?logout=1</summary>
    [SupplyParameterFromQuery]
    public string? Logout { get; set; }

    private bool googleEnabled;

    // Solo rutas locales (evita redirecciones a otros sitios)
    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") ? ReturnUrl : "/";

    private string GoogleUrl => $"auth/login/google?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";

    protected override async Task OnInitializedAsync()
    {
        // Si ya tiene sesión iniciada, no tiene sentido mostrar el login
        if (AuthenticationState != null)
        {
            var state = await AuthenticationState;
            if (state.User.Identity?.IsAuthenticated == true)
            {
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
        }

        // El botón de Google solo aparece si el proveedor está configurado (ClientId y ClientSecret)
        googleEnabled = await SchemeProvider.GetSchemeAsync(GoogleDefaults.AuthenticationScheme) != null;
    }
}
