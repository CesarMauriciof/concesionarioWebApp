@using Logic
@using Model
@inject NavigationManager NavManager
@inject ClientLog ClientLog
@inject EmployeeLog EmployeeLog
@inject SaleLog SaleLog

<h3>Actualizar Venta (ID: @Id)</h3>

@if (objSale == null)
{
    @if (message == null)
    {
        <p>Cargando datos de la venta...</p>
    }
}
else
{
    <EditForm Model="objSale" OnValidSubmit="UpdateSale">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Fecha de Venta:</label>
            <InputDate @bind-Value="objSale.Fecha" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Total Pagado:</label>
            <InputNumber @bind-Value="objSale.TotalPagado" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cliente:</label>
            <InputSelect @bind-Value="objSale.IdCliente" class="form-control">
                <option value="0">-- Seleccione un cliente --</option>
                @foreach (var client in clients)
                {
                    <option value="@client.IdCliente">@client.Nombre (@client.Cedula)</option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Empleado:</label>
            <InputSelect @bind-Value="objSale.IdEmpleado" class="form-control">
                <option value="0">-- Seleccione un empleado --</option>
                @foreach (var employee in employees)
                {
                    <option value="@employee.IdEmpleado">@employee.Nombre - @employee.Cargo</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaleEntity? objSale;
    private string? message;
    private List<ClientEntity> clients = new();
    private List<EmployeeEntity> employees = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clients = await ClientLog.ClientListAsync();
            employees = await EmployeeLog.EmployeeListAsync();
            objSale = await SaleLog.GetSaleByIdAsync(Id);

            if (objSale == null)
            {
                message = "No se encontró la venta especificada.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar la venta: {ex.Message}";
        }
    }

    private async Task UpdateSale()
    {
        try
        {
            if (objSale != null)
            {
                await SaleLog.UpdateSaleAsync(objSale);
                message = "¡Venta actualizada con éxito!";
                NavManager.NavigateTo("/sale/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/sale/list");
    }
}
