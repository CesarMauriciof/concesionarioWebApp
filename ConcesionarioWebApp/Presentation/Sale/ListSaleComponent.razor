@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS

<h3>Gestión de Ventas</h3>

<div class="mb-3">
    <a href="/sale/create" class="btn btn-primary">Nueva Venta</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Venta</th>
        <th>Fecha</th>
        <th>Total Pagado</th>
        <th>ID Cliente</th>
        <th>ID Empleado</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (sales == null)
    {
        <tr>
            <td colspan="6">Cargando ventas...</td>
        </tr>
    }
    else if (!sales.Any())
    {
        <tr>
            <td colspan="6">No hay ventas registradas.</td>
        </tr>
    }
    else
    {
        @foreach (var sale in sales)
        {
            <tr>
                <td>@sale.id_venta</td>
                <td>@sale.fecha.ToShortDateString()</td>
                <td>@sale.total_pagado.ToString("C")</td>
                <td>@sale.id_cliente</td>
                <td>@sale.id_empleado</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(sale.id_venta)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(sale.id_venta)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private string? message;
    private List<SaleEntity>? sales;

    protected override async Task OnInitializedAsync()
    {
        await LoadSales();
    }

    private async Task LoadSales()
    {
        try
        {
            sales = await Task.Run(() => SaleLog.SaleList());
        }
        catch (Exception ex)
        {
            sales ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar la venta #{id}?"))
        {
            return;
        }

        try
        {
            SaleLog.DeleteSale(id);
            message = "Registro eliminado correctamente.";
            await LoadSales();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar la venta: {ex.InnerException?.Message ?? ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/sale/update/{id}");
    }
}