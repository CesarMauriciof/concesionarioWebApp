@using Logic
@using Model
@inject NavigationManager NavManager
@inject ClientLog ClientLog
@inject EmployeeLog EmployeeLog
@inject SaleLog SaleLog

<h3>Registrar Nueva Venta</h3>

<EditForm Model="objSale" OnValidSubmit="SaveSale" FormName="FrmSale">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Fecha de Venta:</label>
        <InputDate @bind-Value="objSale.Fecha" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Total Pagado:</label>
        <InputNumber @bind-Value="objSale.TotalPagado" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cliente:</label>
        <InputSelect @bind-Value="objSale.IdCliente" class="form-control">
            <option value="0">-- Seleccione un cliente --</option>
            @foreach (var client in clients)
            {
                <option value="@client.IdCliente">@client.Nombre (@client.Cedula)</option>
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Empleado:</label>
        <InputSelect @bind-Value="objSale.IdEmpleado" class="form-control">
            <option value="0">-- Seleccione un empleado --</option>
            @foreach (var employee in employees)
            {
                <option value="@employee.IdEmpleado">@employee.Nombre - @employee.Cargo</option>
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Venta</button>
    <a href="/sale/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    SaleEntity objSale = new SaleEntity()
    {
        Fecha = DateTime.Today // Inicializamos con la fecha actual por defecto
    };

    private string? successMessage;

    List<ClientEntity> clients = new List<ClientEntity>();
    List<EmployeeEntity> employees = new List<EmployeeEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Carga de las listas foráneas desde la capa lógica
            clients = await ClientLog.ClientListAsync();
            employees = await EmployeeLog.EmployeeListAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar datos dependientes: {ex.Message}";
        }
    }

    private async Task SaveSale()
    {
        try
        {
            await SaleLog.CreateSaleAsync(objSale);
            successMessage = "¡La venta se guardó exitosamente!";
            objSale = new SaleEntity { Fecha = DateTime.Today };
            NavManager.NavigateTo("/sale/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al guardar la venta: {ex.Message}";
        }
    }
}
