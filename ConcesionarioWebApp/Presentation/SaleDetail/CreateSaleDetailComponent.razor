@using Logic
@using Model
@inject NavigationManager NavManager
@inject SaleDetailLog SaleDetailLog
@inject SaleLog SaleLog
@inject VehicleLog VehicleLog

<h3>Registrar Detalle de Venta</h3>

<EditForm Model="objDetail" OnValidSubmit="SaveDetail" FormName="FrmSaleDetail">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <SaleDetailFields Detail="objDetail" Sales="sales" Vehicles="vehicles" />

    <button type="submit" class="btn btn-primary">Guardar Detalle</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
</EditForm>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private SaleDetailEntity objDetail = new();
    private List<SaleEntity> sales = new();
    private List<VehicleEntity> vehicles = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sales = await SaleLog.SaleListAsync();
            vehicles = await VehicleLog.VehicleListAsync();
        }
        catch (Exception ex)
        {
            message = $"Error al cargar ventas y vehículos: {ex.Message}";
        }
    }

    private async Task SaveDetail()
    {
        try
        {
            await SaleDetailLog.CreateSaleDetailAsync(objDetail);
            NavManager.NavigateTo("/saledetail/list");
        }
        catch (Exception ex)
        {
            message = $"Error al guardar el detalle: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/saledetail/list");
    }
}
