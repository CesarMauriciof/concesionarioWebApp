@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Registrar Detalle de Venta</h3>

<EditForm Model="objDetail" OnValidSubmit="SaveDetail" FormName="FrmSaleDetail">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">ID Venta:</label>
        <InputNumber @bind-Value="objDetail.id_venta" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">ID Vehículo:</label>
        <InputNumber @bind-Value="objDetail.id_vehiculo" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Detalle</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
</EditForm>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private SaleDetailEntity objDetail = new SaleDetailEntity();
    private string? message;

    private void SaveDetail()
    {
        try
        {
            SaleDetailLog.CreateSaleDetail(objDetail);
            message = "¡Detalle de venta guardado con éxito!";
            objDetail = new SaleDetailEntity();
            NavManager.NavigateTo("/saledetail/list");
        }
        catch (Exception ex)
        {
            message = $"Error al guardar el detalle: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/saledetail/list");
    }
}