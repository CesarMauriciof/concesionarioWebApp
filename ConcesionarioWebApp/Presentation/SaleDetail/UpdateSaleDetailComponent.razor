@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Detalle ID: @Id</h3>

@if (objDetail == null)
{
    <p>Cargando datos del detalle...</p>
}
else
{
    <EditForm Model="objDetail" OnValidSubmit="UpdateDetail">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">ID Venta:</label>
            <InputNumber @bind-Value="objDetail.id_venta" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">ID Vehículo:</label>
            <InputNumber @bind-Value="objDetail.id_vehiculo" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaleDetailEntity? objDetail;
    private string? message;
    private List<SaleDetailEntity> details = new();

    protected override async Task OnInitializedAsync()
    {
        details = SaleDetailLog.SaleDetailList();
        objDetail = details.FirstOrDefault(d => d.id_detalle == Id);

        if (objDetail == null)
        {
            message = "No se encontró el detalle de venta especificado.";
        }
    }

    private void UpdateDetail()
    {
        try
        {
            if (objDetail != null)
            {
                SaleDetailLog.UpdateSaleDetail(objDetail);
                message = "¡Detalle actualizado con éxito!";
                NavManager.NavigateTo("/saledetail/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/saledetail/list");
    }
}