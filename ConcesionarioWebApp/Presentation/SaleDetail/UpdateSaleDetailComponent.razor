@using Logic
@using Model
@inject NavigationManager NavManager
@inject SaleDetailLog SaleDetailLog
@inject SaleLog SaleLog
@inject VehicleLog VehicleLog

<h3>Actualizar Detalle de Venta (ID: @Id)</h3>

@if (objDetail == null)
{
    @if (message == null)
    {
        <p>Cargando datos del detalle...</p>
    }
}
else
{
    <EditForm Model="objDetail" OnValidSubmit="UpdateDetail">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <SaleDetailFields Detail="objDetail" Sales="sales" Vehicles="vehicles" />

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SaleDetailEntity? objDetail;
    private List<SaleEntity> sales = new();
    private List<VehicleEntity> vehicles = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sales = await SaleLog.SaleListAsync();
            vehicles = await VehicleLog.VehicleListAsync();
            objDetail = await SaleDetailLog.GetSaleDetailByIdAsync(Id);

            if (objDetail == null)
            {
                message = "No se encontró el detalle de venta especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el detalle: {ex.Message}";
        }
    }

    private async Task UpdateDetail()
    {
        try
        {
            if (objDetail != null)
            {
                await SaleDetailLog.UpdateSaleDetailAsync(objDetail);
                NavManager.NavigateTo("/saledetail/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/saledetail/list");
    }
}
