@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject SaleDetailLog SaleDetailLog

<h3>Gestión de Detalles de Ventas</h3>

<div class="mb-3">
    <a href="/saledetail/create" class="btn btn-primary">Nuevo Detalle</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Detalle</th>
        <th>ID Venta</th>
        <th>Vehículo</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (details == null)
    {
        <tr>
            <td colspan="4">Cargando detalles...</td>
        </tr>
    }
    else if (!details.Any())
    {
        <tr>
            <td colspan="4">No hay detalles registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var detail in details)
        {
            <tr>
                <td>@detail.IdDetalle</td>
                <td>@detail.IdVenta</td>
                <td>@(detail.Vehiculo is null ? $"#{detail.IdVehiculo}" : $"{detail.Vehiculo.Marca} {detail.Vehiculo.Modelo} ({detail.Vehiculo.Vin})")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(detail.IdDetalle)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(detail.IdDetalle)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private string? message;
    private List<SaleDetailEntity>? details;

    protected override async Task OnInitializedAsync()
    {
        await LoadDetails();
    }

    private async Task LoadDetails()
    {
        try
        {
            details = await SaleDetailLog.SaleDetailListAsync();
        }
        catch (Exception ex)
        {
            details ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el detalle de venta #{id}?"))
        {
            return;
        }

        try
        {
            await SaleDetailLog.DeleteSaleDetailAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadDetails();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar el detalle de venta: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/saledetail/update/{id}");
    }
}