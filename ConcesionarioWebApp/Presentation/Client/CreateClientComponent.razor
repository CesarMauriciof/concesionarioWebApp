@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Registrar Nuevo Cliente</h3>

<EditForm Model="objClient" OnValidSubmit="SaveClient">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Cédula:</label>
        <InputText @bind-Value="objClient.Cedula" class="form-control" placeholder="Ingrese la cédula" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre Completo:</label>
        <InputText @bind-Value="objClient.Nombre" class="form-control" placeholder="Ingrese el nombre" />
    </div>

    <div class="mb-3">
        <label class="form-label">Teléfono:</label>
        <InputText @bind-Value="objClient.Telefono" class="form-control" placeholder="Ingrese el teléfono" />
    </div>

    <div class="mb-3">
        <label class="form-label">Correo Electrónico:</label>
        <InputText @bind-Value="objClient.Correo" class="form-control" placeholder="Ingrese el correo electrónico" />
    </div>

    <div class="mb-3">
        <label class="form-label">Dirección:</label>
        <InputText @bind-Value="objClient.Direccion" class="form-control" placeholder="Ingrese la dirección" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cliente</button>
    <a href="/ListClientPage" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    ClientEntity objClient = new ClientEntity();
    private string? successMessage;

    private void SaveClient()
    {
        try
        {
            ClientLog.CreateClient(objClient);
            successMessage = $"¡El cliente {objClient.Nombre} se registró exitosamente!";
            objClient = new ClientEntity();
            NavManager.NavigateTo("/ListClientPage");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el cliente: {ex.Message}";
        }
    }
}