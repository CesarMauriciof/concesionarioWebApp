@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Lista de Clientes</h3>

<div class="mb-3">
    <a href="/CreateClientPage" class="btn btn-success">Registrar Nuevo Cliente</a>
</div>

@if (clients == null)
{
    <p><em>Cargando clientes...</em></p>
}
else if (!clients.Any())
{
    <p>No hay clientes registrados en el sistema.</p>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>ID</th>
            <th>Cédula</th>
            <th>Nombre</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Dirección</th>
            <th>Acciones</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var client in clients)
        {
            <tr>
                <td>@client.Id_Cliente</td>
                <td>@client.Cedula</td>
                <td>@client.Nombre</td>
                <td>@client.Telefono</td>
                <td>@client.Correo</td>
                <td>@client.Direccion</td>
                <td>
                    <button class="btn btn-primary btn-sm" @onclick="() => EditClient(client.Id_Cliente)">Editar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    List<ClientEntity>? clients;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clients = await Task.Run(() => ClientLog.ClientList());
        }
        catch (Exception ex)
        {
            message = $"Error al cargar la lista de clientes: {ex.Message}";
        }
    }

    private void EditClient(int id)
    {
        NavManager.NavigateTo($"/UpdateClientPage/{id}");
    }
}