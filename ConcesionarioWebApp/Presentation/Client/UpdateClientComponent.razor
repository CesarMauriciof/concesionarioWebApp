@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Información del Cliente</h3>

@if (objClient == null)
{
    <p><em>Cargando información del cliente...</em></p>
}
else
{
    <EditForm Model="objClient" OnValidSubmit="UpdateClient" FormName="FrmClientUpdate">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Cédula:</label>
            <InputText @bind-Value="objClient.Cedula" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre Completo:</label>
            <InputText @bind-Value="objClient.Nombre" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Teléfono:</label>
            <InputText @bind-Value="objClient.Telefono" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Correo Electrónico:</label>
            <InputText @bind-Value="objClient.Correo" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Dirección:</label>
            <InputText @bind-Value="objClient.Direccion" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary">Actualizar Cliente</button>
        <a href="/ListClientPage" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (successMessage != null)
{
    <div class="mt-3 alert alert-info">@successMessage</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    ClientEntity? objClient;
    private string? successMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var clients = await Task.Run(() => ClientLog.ClientList());
            objClient = clients.FirstOrDefault(c => c.Id_Cliente == Id);

            if (objClient == null)
            {
                successMessage = "No se encontró el cliente especificado.";
            }
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar el cliente: {ex.Message}";
        }
    }

    private void UpdateClient()
    {
        try
        {
            if (objClient != null)
            {
                ClientLog.UpdateClient(objClient);
                successMessage = $"¡El cliente {objClient.Nombre} se actualizó exitosamente!";
                NavManager.NavigateTo("/client/list");
            }
        }
        catch (Exception ex)
        {
            successMessage = $"Error al actualizar el cliente: {ex.Message}";
        }
    }
}