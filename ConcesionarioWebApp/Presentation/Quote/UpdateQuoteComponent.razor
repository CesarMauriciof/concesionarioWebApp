@using Logic
@using Model
@inject NavigationManager NavManager
@inject QuoteLog QuoteLog
@inject ClientLog ClientLog
@inject VehicleLog VehicleLog
@inject EmployeeLog EmployeeLog

<h3>Actualizar Cotización (ID: @Id)</h3>

@if (objQuote == null)
{
    @if (message == null)
    {
        <p>Cargando datos de la cotización...</p>
    }
}
else
{
    <EditForm Model="objQuote" OnValidSubmit="UpdateQuote">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <QuoteFields Quote="objQuote" Clients="clients" Vehicles="vehicles" Employees="employees" />

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <a href="/quote/list" class="btn btn-secondary ms-2">Cancelar</a>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private QuoteEntity? objQuote;
    private List<ClientEntity> clients = new();
    private List<VehicleEntity> vehicles = new();
    private List<EmployeeEntity> employees = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clients = await ClientLog.ClientListAsync();
            // Al editar se listan todos: el vehículo cotizado pudo venderse después
            vehicles = await VehicleLog.VehicleListAsync();
            employees = await EmployeeLog.EmployeeListAsync();
            objQuote = await QuoteLog.GetQuoteByIdAsync(Id);

            if (objQuote == null)
            {
                message = "No se encontró la cotización especificada.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar la cotización: {ex.Message}";
        }
    }

    private async Task UpdateQuote()
    {
        try
        {
            if (objQuote != null)
            {
                await QuoteLog.UpdateQuoteAsync(objQuote);
                NavManager.NavigateTo("/quote/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar la cotización: {ex.Message}";
        }
    }
}
