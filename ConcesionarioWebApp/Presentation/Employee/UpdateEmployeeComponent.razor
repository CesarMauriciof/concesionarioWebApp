@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Actualizar Empleado ID: @Id</h3>

@if (objEmployee == null)
{
    @if (message == null)
    {
        <p>Cargando datos del empleado...</p>
    }
}
else
{
    <EditForm Model="objEmployee" OnValidSubmit="UpdateEmployee">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Cédula:</label>
            <InputText @bind-Value="objEmployee.Cedula" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre:</label>
            <InputText @bind-Value="objEmployee.Nombre" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Cargo:</label>
            <InputText @bind-Value="objEmployee.Cargo" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Salario:</label>
            <InputNumber @bind-Value="objEmployee.Salario" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Sede:</label>
            <InputSelect @bind-Value="objEmployee.IdSede" class="form-control">
                <option value="0">Seleccione una sede...</option>
                @foreach (var hq in headquartersList)
                {
                    <option value="@hq.IdSede">@hq.NombreSede - @hq.Ciudad</option>
                }
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private EmployeeEntity? objEmployee;
    private string? message;
    private List<HeadquartersEntity> headquartersList = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            headquartersList = await Task.Run(() => HeadquartersLog.HeadquartersList());
            objEmployee = await Task.Run(() => EmployeeLog.GetEmployeeById(Id));

            if (objEmployee == null)
            {
                message = "No se encontró el empleado especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el empleado: {ex.Message}";
        }
    }

    private void UpdateEmployee()
    {
        try
        {
            if (objEmployee != null)
            {
                EmployeeLog.UpdateEmployee(objEmployee);
                message = "¡Empleado actualizado con éxito!";
                NavManager.NavigateTo("/employee/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.InnerException?.Message ?? ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/employee/list");
    }
}