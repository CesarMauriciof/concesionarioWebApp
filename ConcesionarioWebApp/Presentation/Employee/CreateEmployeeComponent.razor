@using Logic
@using Model
@inject NavigationManager NavManager

<h3>Registrar Nuevo Empleado</h3>

<EditForm Model="objEmployee" OnValidSubmit="SaveEmployee" FormName="FrmEmployee">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Cédula:</label>
        <InputText @bind-Value="objEmployee.Cedula" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nombre:</label>
        <InputText @bind-Value="objEmployee.Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Cargo:</label>
        <InputText @bind-Value="objEmployee.Cargo" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Salario:</label>
        <InputNumber @bind-Value="objEmployee.Salario" class="form-control" />
    </div>

    <!-- Selector dinámico de Sede en lugar de un número ciego -->
    <div class="mb-3">
        <label class="form-label">Sede:</label>
        <InputSelect @bind-Value="objEmployee.IdSede" class="form-control">
            <option value="0">Seleccione una sede...</option>
            @if (headquartersList != null)
            {
                @foreach (var hq in headquartersList)
                {
                    <option value="@hq.IdSede">@hq.NombreSede - @hq.Ciudad</option>
                }
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Empleado</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
</EditForm>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private EmployeeEntity objEmployee = new EmployeeEntity();
    private string? message;
    private List<HeadquartersEntity> headquartersList = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Cargamos las sedes disponibles para poblar el menú desplegable
            headquartersList = await Task.Run(() => HeadquartersLog.HeadquartersList());
        }
        catch (Exception ex)
        {
            message = $"Error al cargar las sedes: {ex.Message}";
        }
    }

    private void SaveEmployee()
    {
        try
        {
            if (objEmployee.IdSede == 0)
            {
                message = "Debe seleccionar una sede válida.";
                return;
            }

            EmployeeLog.CreateEmployee(objEmployee);
            message = "¡Empleado guardado con éxito!";
            objEmployee = new EmployeeEntity();
            NavManager.NavigateTo("/employee/list");
        }
        catch (Exception ex)
        {
            message = $"Error al guardar el empleado: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/employee/list");
    }
}