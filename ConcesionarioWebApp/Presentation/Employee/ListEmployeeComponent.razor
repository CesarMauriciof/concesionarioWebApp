@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject EmployeeLog EmployeeLog

<h3>Gestión de Empleados</h3>

<div class="mb-3">
    <a href="/employee/create" class="btn btn-primary">Nuevo Empleado</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID</th>
        <th>Cédula</th>
        <th>Nombre</th>
        <th>Cargo</th>
        <th>Salario</th>
        <th>Sede</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (employees == null)
    {
        <tr>
            <td colspan="7">Cargando empleados...</td>
        </tr>
    }
    else if (!employees.Any())
    {
        <tr>
            <td colspan="7">No hay empleados registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var emp in employees)
        {
            <tr>
                <td>@emp.IdEmpleado</td>
                <td>@emp.Cedula</td>
                <td>@emp.Nombre</td>
                <td>@emp.Cargo</td>
                <td>@emp.Salario.ToString("C")</td>
                <td>@(emp.Sede?.NombreSede ?? "Sin sede")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(emp.IdEmpleado)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(emp.IdEmpleado)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private string? message;
    private List<EmployeeEntity>? employees;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        try
        {
            employees = await EmployeeLog.EmployeeListAsync();
        }
        catch (Exception ex)
        {
            employees ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el empleado #{id}?"))
        {
            return;
        }

        try
        {
            await EmployeeLog.DeleteEmployeeAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadEmployees();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar el empleado: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/employee/update/{id}");
    }
}