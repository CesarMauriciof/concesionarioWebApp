<div class="brand-row">
    <a class="brand" href="">
        <span class="brand-logo" aria-hidden="true">
            <span class="bi bi-car-front-fill-nav-menu"></span>
        </span>
        <span class="brand-text">
            <span class="brand-name">Concesionario</span>
            <span class="brand-sub">Panel administrativo</span>
        </span>
    </a>
    <button title="Menú de navegación" class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Inicio
            </NavLink>
        </div>

        @foreach (var group in menuSections)
        {
            <div class="nav-section">@group.Title</div>
            @foreach (var item in group.Items)
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@item.Href">
                        <span class="bi @item.Icon" aria-hidden="true"></span> @item.Text
                    </NavLink>
                </div>
            }
        }

        @* Gestión de usuarios: solo para el rol Administrador *@
        <AuthorizeView Roles="Administrador">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="user/list">
                    <span class="bi bi-person-lock-nav-menu" aria-hidden="true"></span> Usuarios
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    // Las rutas siguen la convención /<modulo>/list | create | update/{id}
    // Agrupadas por área, como en los paneles administrativos de concesionarios
    private readonly (string Title, (string Href, string Icon, string Text)[] Items)[] menuSections =
    [
        ("Comercial",
        [
            ("client/list", "bi-person-fill-nav-menu", "Clientes"),
            ("quote/list", "bi-file-earmark-text-nav-menu", "Cotizaciones"),
            ("testdrive/list", "bi-calendar-check-nav-menu", "Pruebas de manejo"),
            ("sale/list", "bi-receipt-nav-menu", "Ventas"),
            ("saledetail/list", "bi-card-list-nav-menu", "Detalle Venta"),
        ]),
        ("Inventario",
        [
            ("vehicle/list", "bi-car-front-fill-nav-menu", "Vehículos"),
            ("headquarters/list", "bi-building-nav-menu", "Sedes"),
        ]),
        ("Finanzas",
        [
            ("pay/list", "bi-cash-coin-nav-menu", "Pagos"),
            ("credit/list", "bi-credit-card-nav-menu", "Créditos"),
        ]),
        ("Posventa",
        [
            ("warranty/list", "bi-shield-check-nav-menu", "Garantías"),
            ("maintenance/list", "bi-tools-nav-menu", "Mantenimientos"),
        ]),
        ("Administración",
        [
            ("employee/list", "bi-people-fill-nav-menu", "Empleados"),
        ]),
    ];

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
