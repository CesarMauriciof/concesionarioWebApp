@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4 justify-content-between">
            <div class="topbar-title">
                <span class="topbar-app">Concesionario WebApp</span>
                <span class="topbar-date d-none d-md-inline">@Today</span>
            </div>
            @* Usuario conectado y botón de cerrar sesión (T6 - Mauricio) *@
            <LoginDisplay />
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    // Fecha actual en español (la cultura es-CO se configura en Program.cs)
    private static string Today
    {
        get
        {
            var text = DateTime.Now.ToString("dddd, d 'de' MMMM 'de' yyyy");
            return char.ToUpper(text[0]) + text[1..];
        }
    }
}
