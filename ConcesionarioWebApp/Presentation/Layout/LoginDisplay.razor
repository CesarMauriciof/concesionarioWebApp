@using System.Security.Claims

@*
    Muestra en la barra superior quién inició sesión, su rol y el botón "Cerrar sesión".
    Está incluido en MainLayout.razor.
*@

<AuthorizeView>
    <Authorized>
        <div class="user-box">
            <span class="user-avatar" aria-hidden="true">@Initials(context.User.Identity?.Name)</span>
            <span class="user-info d-none d-sm-flex">
                <span class="user-name">@context.User.Identity?.Name</span>
                <span class="user-role">@context.User.FindFirst(ClaimTypes.Role)?.Value</span>
            </span>

            @* Cerrar sesión SIEMPRE por POST con token antiforgery (no con un enlace) *@
            <form method="post" action="auth/logout" class="m-0">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-sm btn-logout">Cerrar sesión</button>
            </form>
        </div>
    </Authorized>
    <NotAuthorized>
        <a href="login" class="btn btn-sm btn-primary">Iniciar sesión</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    // Iniciales para el avatar: "adriana" → "A", "Juan Pérez" → "JP"
    private static string Initials(string? name)
    {
        var parts = (name ?? "?").Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpper(),
            _ => (parts[0][..1] + parts[1][..1]).ToUpper()
        };
    }
}
