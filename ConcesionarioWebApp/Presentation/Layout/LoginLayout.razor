    <main class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
                <div class="text-center mb-3">
                    <span class="display-6" aria-hidden="true">🚗</span>
                </div>
                @Body
            </div>
        </div>
    </main>
</div>