@inherits LayoutComponentBase

@* Layout de las páginas públicas (login, acceso denegado): sin menú lateral. *@

<div class="auth-page">
    <aside class="auth-hero d-none d-lg-flex">
        <div class="auth-hero-brand">
            <span class="auth-hero-logo" aria-hidden="true">
                <span class="bi bi-car-front-fill-nav-menu"></span>
            </span>
            <span>Concesionario</span>
        </div>

        <div>
            <h2 class="auth-hero-title">Panel administrativo</h2>
            <p class="auth-hero-text">
                Inventario por sede, clientes, cotizaciones, ventas, pagos, créditos y posventa en un solo lugar.
            </p>
            <ul class="auth-hero-list">
                <li><span class="bi bi-car-front-fill-nav-menu" aria-hidden="true"></span> Inventario de vehículos</li>
                <li><span class="bi bi-receipt-nav-menu" aria-hidden="true"></span> Ventas y cotizaciones</li>
                <li><span class="bi bi-tools-nav-menu" aria-hidden="true"></span> Garantías y mantenimientos</li>
            </ul>
        </div>

        <small class="auth-hero-foot">Acceso exclusivo para personal autorizado</small>
    </aside>

    <main class="auth-main">
        <div class="auth-box">
            <div class="text-center mb-3 d-lg-none">
                <span class="auth-hero-logo" aria-hidden="true">
                    <span class="bi bi-car-front-fill-nav-menu"></span>
                </span>
            </div>
            @Body
        </div>
    </main>
</div>
