@using Model
@using Logic 
@inject NavigationManager NavManager
@inject PayLog PayLog
@inject SaleLog SaleLog

<h3>Registrar Pago</h3>

<EditForm Model="objPay" OnValidSubmit="SavePay" FormName="FrmPay">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Venta Asociada:</label>
        <InputSelect @bind-Value="objPay.IdVenta" class="form-select">
            <option value="0">-- Seleccione una Venta --</option>
            @if (sales != null)
            {
                @foreach (var sale in sales)
                {
                    <option value="@sale.IdVenta">
                        Venta #@sale.IdVenta
                    </option>
                }
            }
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Monto a Pagar:</label>
        <InputNumber @bind-Value="objPay.Monto" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Fecha de Pago:</label>
        <InputDate @bind-Value="objPay.FechaPago" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Método de Pago:</label>
        <InputSelect @bind-Value="objPay.MetodoPago" class="form-select">
            <option value="">-- Seleccione Método --</option>
            <option value="EFECTIVO">Efectivo</option>
            <option value="TRANSFERENCIA">Transferencia Bancaria</option>
            <option value="CREDITO">Crédito Bancario</option>
            <option value="CHEQUE">Cheque</option>
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Guardar Pago</button>
    <a href="/pay/list" class="btn btn-secondary ms-2">Cancelar</a>
</EditForm>

@if (successMessage != null)
{
    <div class="alert alert-info mt-2">@successMessage</div>
}

@code {
    PayEntity objPay = new PayEntity() 
    { 
        FechaPago = DateTime.Now 
    };

    private string? successMessage;
    List<SaleEntity> sales = new List<SaleEntity>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sales = await SaleLog.SaleListAsync();
        }
        catch (Exception ex)
        {
            successMessage = $"Error al cargar ventas: {ex.Message}";
        }
    }

    private async Task SavePay()
    {
        try
        {
            await PayLog.CreatePayAsync(objPay);

            successMessage = $"El pago por valor de ${objPay.Monto} se guardó exitosamente!";
            objPay = new PayEntity() { FechaPago = DateTime.Now };

            NavManager.NavigateTo("/pay/list");
        }
        catch (Exception ex)
        {
            successMessage = $"Error al registrar el pago: {ex.Message}";
        }
    }
}