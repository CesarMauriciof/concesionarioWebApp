@using Logic
@using Model
@inject NavigationManager NavManager
@inject IJSRuntime JS
@inject PayLog PayLog

<h3>Historial de Pagos</h3>

<div class="mb-3">
    <a href="/pay/create" class="btn btn-primary">Nuevo Pago</a>
</div>

<table class="table table-striped">
    <thead>
    <tr>
        <th>ID Pago</th>
        <th>ID Venta</th>
        <th>Monto</th>
        <th>Fecha de Pago</th>
        <th>Método de Pago</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @if (pays == null)
    {
        <tr>
            <td colspan="6">Cargando pagos...</td>
        </tr>
    }
    else if (!pays.Any())
    {
        <tr>
            <td colspan="6">No hay pagos registrados.</td>
        </tr>
    }
    else
    {
        @foreach (var pay in pays)
        {
            <tr>
                <td>@pay.IdPago</td>
                <td>@pay.IdVenta</td>
                <td>@pay.Monto.ToString("C")</td>
                <td>@pay.FechaPago.ToString("dd/MM/yyyy")</td>
                <td>@pay.MetodoPago</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => GoToUpdate(pay.IdPago)">
                        Editar
                    </button>
                    <button class="btn btn-danger btn-sm ms-1" @onclick="() => Delete(pay.IdPago)">
                        Eliminar
                    </button>
                </td>
            </tr>
        }
    }
    </tbody>
</table>

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    private string? message;
    private List<PayEntity>? pays;

    protected override async Task OnInitializedAsync()
    {
        await LoadPays();
    }

    private async Task LoadPays()
    {
        try
        {
            pays = await PayLog.PayListAsync();
        }
        catch (Exception ex)
        {
            pays ??= new();
            message = $"Error al cargar los datos: {ex.Message}";
        }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Desea eliminar el pago #{id}?"))
        {
            return;
        }

        try
        {
            await PayLog.DeletePayAsync(id);
            message = "Registro eliminado correctamente.";
            await LoadPays();
        }
        catch (Exception ex)
        {
            message = $"No se pudo eliminar el pago: {ex.Message}";
        }
    }

    private void GoToUpdate(int id)
    {
        NavManager.NavigateTo($"/pay/update/{id}");
    }
}