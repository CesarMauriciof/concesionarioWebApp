@using Logic
@using Model
@inject NavigationManager NavManager
@inject PayLog PayLog
@inject SaleLog SaleLog

<h3>Actualizar Pago (ID: @Id)</h3>

@if (objPay == null)
{
    @if (message == null)
    {
        <p>Cargando datos del pago...</p>
    }
}
else
{
    <EditForm Model="objPay" OnValidSubmit="UpdatePay">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Venta Asociada:</label>
            <InputSelect @bind-Value="objPay.IdVenta" class="form-control">
                <option value="0">-- Seleccione una Venta --</option>
                @foreach (var sale in sales)
                {
                    <option value="@sale.IdVenta">
                        Venta #@sale.IdVenta (@sale.TotalPagado.ToString("C"))
                    </option>
                }
            </InputSelect>
        </div>

        <div class="mb-3">
            <label class="form-label">Monto:</label>
            <InputNumber @bind-Value="objPay.Monto" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha de Pago:</label>
            <InputDate @bind-Value="objPay.FechaPago" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Método de Pago:</label>
            <InputSelect @bind-Value="objPay.MetodoPago" class="form-control">
                <option value="">-- Seleccione Método --</option>
                <option value="EFECTIVO">Efectivo</option>
                <option value="TRANSFERENCIA">Transferencia Bancaria</option>
                <option value="CREDITO">Crédito Bancario</option>
                <option value="CHEQUE">Cheque</option>
            </InputSelect>
        </div>

        <button type="submit" class="btn btn-success">Guardar Cambios</button>
        <button type="button" class="btn btn-secondary ms-2" @onclick="Cancel">Cancelar</button>
    </EditForm>
}

@if (message != null)
{
    <div class="mt-3 alert alert-info">@message</div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private PayEntity? objPay;
    private List<SaleEntity> sales = new();
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            sales = await SaleLog.SaleListAsync();
            objPay = await PayLog.GetPayByIdAsync(Id);

            if (objPay == null)
            {
                message = "No se encontró el pago especificado.";
            }
        }
        catch (Exception ex)
        {
            message = $"Error al cargar el pago: {ex.Message}";
        }
    }

    private async Task UpdatePay()
    {
        try
        {
            if (objPay != null)
            {
                await PayLog.UpdatePayAsync(objPay);
                message = "¡Pago actualizado con éxito!";
                NavManager.NavigateTo("/pay/list");
            }
        }
        catch (Exception ex)
        {
            message = $"Error al actualizar: {ex.Message}";
        }
    }

    private void Cancel()
    {
        NavManager.NavigateTo("/pay/list");
    }
}
