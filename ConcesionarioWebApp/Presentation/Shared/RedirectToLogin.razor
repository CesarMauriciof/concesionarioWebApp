@inject NavigationManager Navigation

@*
    Redirige al formulario de login cuando alguien sin sesión entra a una página protegida.
    Lo usa Routes.razor dentro de <AuthorizeRouteView>.
*@

@code {
    protected override void OnInitialized()
    {
        // Ruta actual (p. ej. "sale/list?x=1") para volver a ella después de iniciar sesión
        var returnUrl = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

        // forceLoad: el login necesita una petición HTTP completa, no navegación interna de Blazor
        Navigation.NavigateTo($"login?returnUrl={Uri.EscapeDataString(returnUrl)}", forceLoad: true);
    }
}