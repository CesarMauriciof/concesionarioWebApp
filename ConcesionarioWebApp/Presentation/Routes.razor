<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        @* Exige sesión en todas las páginas (salvo las que tienen [AllowAnonymous]) *@
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    @* Sin sesión: al formulario de login, recordando la página pedida *@
                    <RedirectToLogin />
                }
                else
                {
                    @* Con sesión pero sin el rol necesario *@
                    <p role="alert" class="alert alert-danger">No tiene permisos para ver esta página.</p>
                }
            </NotAuthorized>
            <Authorizing>
                <p class="text-body-secondary">Verificando permisos...</p>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
    <NotFound>
        <PageTitle>Página no encontrada</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <h3>Página no encontrada</h3>
            <p role="alert">La dirección solicitada no existe. <a href="">Volver al inicio</a>.</p>
        </LayoutView>
    </NotFound>
</Router>
